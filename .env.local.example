# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.

# MongoDB Atlas connection string (free tier is fine to start).
# Get it from: https://www.mongodb.com/cloud/atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/repily?retryWrites=true&w=majority

# Any long random string, used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Powers the AI Coach (/coach). Free, no credit card required.
# Get one at: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=replace-this-with-your-gemini-api-key

# Optional — defaults to gemini-2.5-flash-lite if not set.
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- Phase 6: Nutrition ---

# Powers food search images (fallback for foods Spoonacular has no photo for).
# Free. Get one at: https://unsplash.com/developers -> New Application -> Access Key
UNSPLASH_ACCESS_KEY=replace-this-with-your-unsplash-access-key

# Powers accurate macro data (calories/protein/carbs/fat). Free, uncapped.
# Get one instantly at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=replace-this-with-your-usda-key

# Powers ingredient/recipe search with matched food photos + nutrition.
# Free tier is capped (~150 requests/day) — results are cached in Mongo, so
# this only gets hit on first-ever search for a given food.
# Get one at: https://spoonacular.com/food-api/console#Dashboard
SPOONACULAR_API_KEY=replace-this-with-your-spoonacular-key

# --- Phase 7: Form Check ---
# No new env vars. Pose detection (@mediapipe/tasks-vision) runs entirely
# client-side and is free/keyless. The AI summary reuses GEMINI_API_KEY above.
